# ---------------------------------------------------------------------------
# ironpulse — Docker Compose environment
#
# This is the SINGLE place to change ports. Whatever you set here is used
# to (a) bind the container's internal listeners AND (b) map them onto
# your host — so the two can never drift out of sync (see
# docs/adr/0003-env-driven-config.md for why that used to be a problem).
#
# If a port below is already taken on your machine (a very common
# conflict: 8080 is used by Jenkins, Open WebUI, and countless other dev
# tools), just change the number here and run `docker compose up` again.
# No other file needs to change.
# ---------------------------------------------------------------------------

# Port for the REST API + dashboard (http://localhost:<HTTP_PORT>)
HTTP_PORT=8080

# Port for the WebSocket live-push server
WS_PORT=8081

# Which network interface ironpulse's ports bind to.
#   0.0.0.0  (default) — reachable from any network interface. Fine for
#            local development or a standalone demo VDS with no other
#            reverse proxy in front.
#   127.0.0.1 — reachable only from this machine. Use this in production
#            when an existing host-level nginx (or other reverse proxy)
#            is the only thing that should be able to reach ironpulse —
#            see deploy/nginx/anton-tests.ru.conf and
#            docker-compose.prod.yml for that setup.
IRONPULSE_BIND_HOST=0.0.0.0

# Port for the nginx reverse proxy (the "front door" for a real
# deployment — see deploy/nginx/). Not used if you talk to `ironpulse`
# directly on HTTP_PORT during local development.
NGINX_PORT=80

# Port the bundled Modbus device simulator listens on.
SIMULATOR_PORT=5020

# How many hours of telemetry to retain in the write-ahead log.
RETENTION_HOURS=168

# Number of io_context worker threads inside the ironpulse container.
WORKER_THREADS=4
